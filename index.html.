<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UTILORA - Boutique en ligne</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        nav {
            background-color: #000;
            padding: 20px;
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 100;
        }
        nav ul {
            display: flex;
            justify-content: center;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        nav ul li {
            margin: 0 20px;
        }
        nav ul li a {
            color: #fff;
            text-decoration: none;
            font-size: 1.1rem;
        }
        section {
            padding: 100px 20px 50px;
        }
        h2 {
            font-size: 2.5rem;
            margin-bottom: 30px;
            text-align: center;
        }
        .category {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
        }
        .category div {
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            width: 30%;
            margin-bottom: 30px;
            transition: transform 0.3s ease;
        }
        .category div:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }
        .category div img {
            width: 100%;
            border-radius: 8px;
        }
        .category div h3 {
            font-size: 1.2rem;
            margin-top: 10px;
        }
        .category div p {
            font-size: 1rem;
            color: gray;
        }
        a {
            display: inline-block;
            padding: 10px 20px;
            background-color: #000;
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
        }
        .smooth-scroll {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
        .smooth-scroll a {
            font-size: 1rem;
            text-decoration: none;
            color: #000;
        }
        .smooth-scroll a:hover {
            color: #333;
        }
    </style>
</head>
<body>

<nav>
    <ul>
